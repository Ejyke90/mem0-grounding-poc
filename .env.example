# Ollama (local, free) - no API key needed
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2
# MEM0_LLM_MODEL=llama3.2
# MEM0_EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# Email ingestion: auth method
# EMAIL_AUTH_METHOD=auto   # auto | oauth2 | app_password
# ---------------------------------------------------------------------------

# OAuth2 (recommended). Run the one-time flow after setting client creds:
#   python -m src.ingestion.email_sources.oauth_flow --provider gmail
#   python -m src.ingestion.email_sources.oauth_flow --provider yahoo

# Gmail: Google Cloud Console -> APIs & Services -> Credentials ->
#        "Create OAuth client ID", type "Desktop app".
#        Enable the Gmail API for the project.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# or point to a downloaded client_secrets.json instead:
# GOOGLE_CLIENT_SECRETS_FILE=

# Yahoo: Yahoo Developer Network -> Create App -> Mail (Read) scope
#        Redirect URI: http://localhost:8765/callback (or "oob")
# YAHOO_CLIENT_ID=
# YAHOO_CLIENT_SECRET=
# YAHOO_REDIRECT_URI=http://localhost:8765/callback

# Token cache directory (created automatically, already gitignored)
# OAUTH_TOKEN_DIR=.data/tokens

# App-password fallback (only needed if you don't configure OAuth2):
#   Gmail:  https://myaccount.google.com/apppasswords (requires 2-Step Verification)
#   Yahoo:  https://login.yahoo.com/account/security -> "Generate app password"
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# YAHOO_USER=you@yahoo.com
# YAHOO_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# (YAHOO_USER is also used as the mailbox identity for Yahoo OAuth if the
#  token was authorized without the openid/email scope)

# ---------------------------------------------------------------------------
# Object storage: any S3-compatible free tier works
# Cloudflare R2 (recommended): https://dash.cloudflare.com -> R2 -> Manage API Tokens
#   OBJECT_STORAGE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
#   OBJECT_STORAGE_REGION=auto
# Backblaze B2: https://www.backblaze.com/b2 -> Application Keys
#   OBJECT_STORAGE_ENDPOINT_URL=https://s3.<region>.backblazeb2.com
#   OBJECT_STORAGE_REGION=<region>
# OBJECT_STORAGE_ENDPOINT_URL=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_REGION=auto
